      <!-- North wall with door (to corridor 2), gap x[-2,-1] -->
      <link name="r1_north_a">
        <pose>-2.25 -5 1.25 0 0 0</pose>
        <collision name="r1na_col"><geometry><box><size>0.5 0.3 2.5</size></box></geometry></collision>
