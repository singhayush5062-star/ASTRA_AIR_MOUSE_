<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="nidar_airmouse_arena">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>


    <!--
      ================================================================
      NIDAR AIRMOUSE ARENA - MAZE LAYOUT NOTES
      ================================================================
      Arena footprint : 15m x 15m  (x,y in [-7.5, 7.5])
      Wall thickness  : 0.30 m
      Wall height     : 2.50 m   (clears 8 ft / 2.44 m requirement)
      Room size       : 2m x 2m
      Door width      : 1.0 m   (achieved by splitting a wall into two
                        0.5m "jamb" segments with a 1m gap between them)
      Corridor width  : 1.2 m clear (walls set 1.2m apart, center-to-center)
      Launch pad      : 0.61m x 0.61m (2 ft x 2 ft), SW corner

      Path flow:
        Launch Pad -> Corridor 1 (E) -> Room 1 -> Corridor 2 (N)
          -> [branch W -> Room 5, dead-end trap room]
          -> Room 2 -> Corridor 3 (E) -> Room 3 -> Corridor 4 (N)
          -> Room 4 (goal room, has a small pillar obstacle)

      A separate "Pillar Gauntlet" strip runs along the east edge
      (x = 5.3 to 7.2), accessible via a door in the divider wall,
      containing 5 staggered cylindrical pillars as a slalom obstacle
      course - added purely for extra difficulty/toughness.
      ================================================================
    -->

    <model name="nidar_maze">
      <static>true</static>

      <!-- ============ OUTER BOUNDARY WALLS (15m x 15m) ============ -->
      <link name="wall_north">
        <pose>0 7.5 1.25 0 0 0</pose>
        <collision name="col_north"><geometry><box><size>15 0.3 2.5</size></box></geometry></collision>
        <visual name="vis_north"><geometry><box><size>15 0.3 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <link name="wall_south">
        <pose>0 -7.5 1.25 0 0 0</pose>
        <collision name="col_south"><geometry><box><size>15 0.3 2.5</size></box></geometry></collision>
        <visual name="vis_south"><geometry><box><size>15 0.3 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>7.5 0 1.25 0 0 0</pose>
        <collision name="col_east"><geometry><box><size>0.3 15 2.5</size></box></geometry></collision>
        <visual name="vis_east"><geometry><box><size>0.3 15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-7.5 0 1.25 0 0 0</pose>
        <collision name="col_west"><geometry><box><size>0.3 15 2.5</size></box></geometry></collision>
        <visual name="vis_west"><geometry><box><size>0.3 15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <!-- ============ LAUNCH PAD (2ft x 2ft = 0.61m x 0.61m) ============ -->
      <link name="launch_pad">
        <pose>-6.5 -6.5 0.01 0 0 0</pose>
        <collision name="col_pad"><geometry><box><size>0.61 0.61 0.02</size></box></geometry></collision>
        <visual name="vis_pad"><geometry><box><size>0.61 0.61 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>

      <!-- ============ CORRIDOR 1: Launch pad -> Room 1 (horizontal, y=-6) ============ -->
      <link name="corr1_wall_south">
        <pose>-4.85 -6.6 1.25 0 0 0</pose>
        <collision name="c1s_col"><geometry><box><size>4.7 0.3 2.5</size></box></geometry></collision>
        <visual name="c1s_vis"><geometry><box><size>4.7 0.3 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
      <link name="corr1_wall_north">
        <pose>-4.85 -5.4 1.25 0 0 0</pose>
