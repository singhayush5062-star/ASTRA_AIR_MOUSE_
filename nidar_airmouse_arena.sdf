      </link>

      <!-- ============ ROOM 5: dead-end trap room, branch off corridor 2 ============ -->
      <!-- East side of room 5 reuses corridor2_wall_west_a/b as its wall; only the 1m gap is the door -->
      <link name="r5_west">
        <pose>-4.1 -2.5 1.25 0 0 0</pose>
        <collision name="r5w_col"><geometry><box><size>0.3 2 2.5</size></box></geometry></collision>
