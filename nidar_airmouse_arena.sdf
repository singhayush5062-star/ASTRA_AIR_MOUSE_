        <pose>-1.5 -7 1.25 0 0 0</pose>
        <collision name="r1s_col"><geometry><box><size>2 0.3 2.5</size></box></geometry></collision>
        <visual name="r1s_vis"><geometry><box><size>2 0.3 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
