<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="nidar_competition_world">
    <!-- Directional Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- NIDAR Arena DAE Mesh Model -->
    <include>
      <name>nidar_arena</name>
      <uri>model://nidar_arena</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Physics Engine Configuration -->
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>
    </physics>

    <!-- Scene lighting / shadows -->
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.15 0.15 0.15 1.0</background>
      <shadows>false</shadows>
    </scene>
  </world>
</sdf>
