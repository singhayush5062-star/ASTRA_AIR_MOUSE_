# Build directories and binary outputs
**/build/
**/devel/
**/logs/
**/*.log
**/*.o
**/*.so
**/*.a


# Hidden system and temporary editor files
.DS_Store
*.swp
*.swo
*~
__pycache__/
*.pyc
*.pyo
*.tmp
.gitignore_container
Makefile_px4

# ROS bag recordings and temporary bags
rosbags/
*.bag
*.bag.active

# Host temp files
host_test.txt

# Root-level redundant FAST_LIO folder (active code is in catkin_ws/src/FAST_LIO)
/FAST_LIO/

# Local backup/export archives - never committed (repo is already large; these are per-machine)
/nidar_airmouse.tar.gz
/ros_workspace.tar.gz

# YOLO weights auto-downloaded by scripts/test_gpu_inference.py when run from repo root
/yolov8n.pt

# Survivor detection model download zip is throwaway; extracted contents under
# catkin_ws/src/nidar_perception/models/detection/ are what runtime loads and ARE committed.
/PERSON_DETECTION_MODEL_V*.zip
/yolo26s_drone_person_v*.zip
catkin_ws/src/nidar_perception/models/detection/**/__pycache__/



# Claude Code graphify analysis cache - regenerable, never commit
graphify-out/
graphify/
PLANNING_DOCS/archive/

# Jetson-only catkin profile (scripts/jetson_onboard.sh build) and onboard run logs
catkin_ws/.catkin_tools/profiles/jetson/
# Raspberry Pi 4: the container links catkin_ws/devel to the workspace in the image (a symlink,
# which **/devel/ does not match); exported images (scripts/pi4_onboard.sh export)
catkin_ws/devel
nidar-onboard-pi4_*.tar.gz
