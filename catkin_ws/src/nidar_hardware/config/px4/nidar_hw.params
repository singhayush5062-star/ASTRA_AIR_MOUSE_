#
# What each value is for:
#   MAV_0_CONFIG       101        TELEM1 = T12 / SiK radio to the GCS
#   MAV_0_MODE         0          Normal (GCS telemetry)
#   SER_TEL1_BAUD      57600      radio data-link baud
#   MAV_0_FORWARD      1          forward GCS <-> Jetson (TAKEOFF/RTL over the radio)
#   MAV_1_CONFIG       102        TELEM2 = Jetson (MAVROS)
#   MAV_1_MODE         2          Onboard
#   SER_TEL2_BAUD      921600     Jetson link baud
#   MAV_1_FORWARD      1          forward Jetson <-> GCS (mission STATUSTEXT, ACKs)
#   UXRCE_DDS_CFG      0          no ROS 2 DDS client: TELEM2 is MAVLink
#   EKF2_EV_CTRL       11         vision horizontal pos + vertical pos + yaw
#   EKF2_HGT_REF       3          height reference = vision (FAST-LIO Z = TFmini, obstacle gated)
#   EKF2_RNG_CTRL      0          PX4 does not fuse the raw range (see SITL airframe notes)
#   EKF2_BARO_CTRL     1          baro as a backup across vision gaps
#   EKF2_GPS_CTRL      0          GPS-denied
#   EKF2_MAG_TYPE      5          no magnetometer fusion (indoors; heading from FAST-LIO)
#   SYS_HAS_MAG        0          no compass pre-flight checks
#   COM_ARM_MAG_STR    0          no field-strength check
#   COM_ARM_WO_GPS     1          arm without GPS
#   EKF2_EV_DELAY      60.0       FAST-LIO pose latency, ms
#   EKF2_EVP_NOISE     0.1        measured FAST-LIO accuracy (SITL airframe notes)
#   EKF2_EVA_NOISE     0.05       vision yaw noise, rad
#   EKF2_EV_POS_X      0.011      vision sensor fwd of base_link
#   EKF2_EV_POS_Y      -0.02329   vision sensor right (FRD)
#   EKF2_EV_POS_Z      0.0        Z referred to base_link by FAST-LIO already
#   EKF2_RNG_POS_X     0.0        TFmini fwd of base_link
#   EKF2_RNG_POS_Y     0.0        TFmini right (FRD)
#   EKF2_RNG_POS_Z     0.06       TFmini below base_link (FRD down)
#   EKF2_MIN_RNG       0.1        TFmini minimum range
#   MIS_TAKEOFF_ALT    1.5        AUTO.TAKEOFF height (mission cruise)
#   MPC_THR_HOVER      0.45       hover throttle
#   MPC_Z_VEL_MAX_UP   1.0        max climb m/s
#   MPC_TKO_SPEED      0.8        takeoff climb m/s
#   MPC_LAND_SPEED     0.5        final descent m/s
#   MPC_XY_VEL_MAX     1.0        horizontal cap m/s
#   MC_YAWRATE_MAX     60.0       LiDAR de-skew limit, deg/s
#   MPC_YAWRAUTO_MAX   60.0       same, auto modes
#   COM_RC_IN_MODE     0          RC transmitter (T12) is the safety pilot
#   NAV_RCL_ACT        3          RC loss -> Land
#   COM_RCL_EXCEPT     4          except in Offboard: the autonomous mission continues
#   NAV_DLL_ACT        0          GCS link loss: mission continues onboard
#   COM_OF_LOSS_T      1.0        offboard setpoint timeout, s
#   COM_OBL_RC_ACT     4          offboard loss (Jetson stack died) -> Land
#   COM_LOW_BAT_ACT    2          critical battery -> Land (mission RTL fires earlier)
#   CBRK_FLIGHTTERM    0          terminate on attitude failure (>60 deg), as in SITL
#   SENS_TFMINI_CFG    202        TFmini Plus on GPS2
