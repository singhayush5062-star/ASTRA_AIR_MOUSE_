<launch>
  <arg name="map_size_x_"/>
  <arg name="map_size_y_"/>
  <arg name="map_size_z_"/>

  <arg name="box_min_x"/>
  <arg name="box_min_y"/>
  <arg name="box_min_z"/>
  <arg name="box_max_x"/>
  <arg name="box_max_y"/>
  <arg name="box_max_z"/>

  <arg name="odometry_topic"/>
  <arg name="sensor_pose_topic"/>
  <arg name="depth_topic"/>
  <arg name="cloud_topic"/>

  <arg name="cx"/>
  <arg name="cy"/>
  <arg name="fx"/>
  <arg name="fy"/>

  <arg name="max_vel"/>
  <arg name="max_acc"/>

  <!-- main node -->
  <node pkg="exploration_manager" name="exploration_node" type="exploration_node" output="screen">
    <remap from ="/odom_world" to="$(arg odometry_topic)"/>
    <remap from ="/map_ros/pose"   to = "$(arg sensor_pose_topic)"/> 
    <remap from ="/map_ros/depth" to = "$(arg depth_topic)"/>
    <remap from ="/map_ros/cloud" to="$(arg cloud_topic)"/>

    <param name="sdf_map/resolution"      value="0.1" /> 
    <param name="sdf_map/map_size_x"   value="$(arg map_size_x_)" /> 
    <param name="sdf_map/map_size_y"   value="$(arg map_size_y_)" /> 
    <param name="sdf_map/map_size_z"   value="$(arg map_size_z_)" /> 
    <!-- <param name="sdf_map/obstacles_inflation"     value="0.099" />  -->
    <!-- was 0.199. FUEL models the vehicle as a POINT and relies entirely on this inflation to
         represent its size, but the Iris is 0.767 m across: rotors sit at (+/-0.13, +/-0.22)
         = 0.2555 m from centre and each rotor collision cylinder adds 0.128 m, so the true
         collision radius is 0.384 m. At 0.199 the planner was routing the vehicle through gaps
         roughly half its own width, so the props physically wedged against walls.
         Measured on run 13_34_32: groundtruth held the vehicle STATIC at world (6.89, 4.70),
         0.20 m from the nearest wall (its props 0.18 m inside that wall), for 8+ seconds
         while the estimator believed it was still flying and drifted from 1.6 m to 4.9 m of
         error before the run was lost. That is the "drone gets stuck on the vertical walls"
         failure: a physical wedge, not a control or SLAM bug (the SLAM divergence follows the
         contact, it does not cause it).
         0.42 = 0.384 collision radius + 0.036 margin, which is about 1 sigma of the measured
         2.6-4.0 cm position tracking jitter. This arena is the binding constraint, not the
         value: median clearance is only 0.42 m and the widest point is 1.26 m, so connected
         navigable area is 70.5 m2 at 0.42 vs 134.1 m2 at 0.199, but that larger figure was
         never real: it counted gaps the airframe cannot pass. Spawn (0,-6.5) has 0.62 m and the
         tightest point on its exit corridor 0.47 m, so egress still works.
         Raise toward 0.45 for more margin at the cost of area (65.0 m2); do not go below 0.384
         under any circumstances. -->
    <param name="sdf_map/obstacles_inflation"     value="0.4" />
    <param name="sdf_map/local_bound_inflate"    value="0.5"/>
    <param name="sdf_map/local_map_margin" value="50"/>
    <param name="sdf_map/ground_height"        value="-1.0"/>
    <param name="sdf_map/default_dist"        value="0.0"/>
    
    <param name="sdf_map/p_hit"  value="0.65"/>
    <param name="sdf_map/p_miss" value="0.35"/>
    <param name="sdf_map/p_min"  value="0.12"/>
    <param name="sdf_map/p_max"  value="0.90"/>
    <param name="sdf_map/p_occ"  value="0.80"/>
    <param name="sdf_map/min_ray_length" value="0.5"/>
    <param name="sdf_map/max_ray_length" value="6.5"/>
    <param name="sdf_map/virtual_ceil_height"   value="1.9"/>
    <param name="sdf_map/optimistic" value="false" type="bool"/>
    <param name="sdf_map/signed_dist" value="false" type="bool"/>
    <param name="sdf_map/box_min_x" value="$(arg box_min_x)" type="double"/>
    <param name="sdf_map/box_min_y" value="$(arg box_min_y)" type="double"/>
    <param name="sdf_map/box_min_z" value="$(arg box_min_z)" type="double"/>
    <param name="sdf_map/box_max_x" value="$(arg box_max_x)" type="double"/>
    <param name="sdf_map/box_max_y" value="$(arg box_max_y)" type="double"/>
    <param name="sdf_map/box_max_z" value="$(arg box_max_z)" type="double"/>

    <param name="map_ros/cx" value="$(arg cx)"/>
    <param name="map_ros/cy" value="$(arg cy)"/>
    <param name="map_ros/fx" value="$(arg fx)"/>
    <param name="map_ros/fy" value="$(arg fy)"/>
    <param name="map_ros/depth_filter_maxdist"   value="5.0"/>
    <param name="map_ros/depth_filter_mindist"   value="0.2"/>
    <param name="map_ros/depth_filter_margin"    value="2"/>
    <param name="map_ros/k_depth_scaling_factor" value="1000.0"/>
    <param name="map_ros/skip_pixel" value="2"/>
    <param name="map_ros/esdf_slice_height" value="0.3"/>
    <!-- Coverage report. arena_area_m2 is the denominator for "percent explored": the arena's
         own navigable free area at the cruise slice, measured off the mesh and kept in step by
         the generator (nidar.arenas.<active>.measured.free_area_m2). Without it map_ros falls
         back to the map bounding box, which includes the walls and everything behind them, so
         the percentage tops out far below 100 and is useless as a progress signal.
         These MUST live here, not on traj_server: MapROS is owned by exploration_node, and a
         param set on the wrong node is silently ignored (measured: the report fell back to the
         191.8 m2 bounding box instead of the 158.0 m2 arena). -->
    <param name="map_ros/arena_area_m2" value="158.0" type="double"/>
    <!-- Publish the box's UNKNOWN voxels on /sdf_map/unknown, assembled inside the coverage
         sweep that already classifies them. Upstream leaves publishUnknown() commented out, so
         without this the topic is advertised but silent and nothing downstream can distinguish
         unknown space from free space when reconstructing the map; a recorded grid then
         reports every unmapped cell as mapped. roscpp does not serialise a message with no
         subscribers, so this is free unless something is actually recording. -->
    <param name="map_ros/publish_unknown" value="true" type="bool"/>
    <param name="map_ros/coverage_interval" value="2.0" type="double"/>
    <param name="map_ros/visualization_truncate_height"   value="10.09"/>
    <param name="map_ros/visualization_truncate_low"   value="-2.0"/>
    <param name="map_ros/show_occ_time"  value="false"/>
    <param name="map_ros/show_esdf_time" value="false"/>
    <param name="map_ros/show_all_map" value="true"/>
    <param name="map_ros/frame_id"      value="world"/>

    <!-- Fsm -->
    <param name="fsm/thresh_replan1" value="0.5" type="double"/>
    <param name="fsm/thresh_replan2" value="0.5" type="double"/>
    <param name="fsm/thresh_replan3" value="1.5" type="double"/>

    <!-- <param name="fsm/thresh_replan1" value="0.00001" type="double"/> -->
    <!-- <param name="fsm/thresh_replan2" value="100.0" type="double"/> -->
    <!-- <param name="fsm/thresh_replan3" value="0.1" type="double"/> -->
    <param name="fsm/replan_time" value="0.200" type="double"/>

    <!-- FINISH-state recovery. Upstream FUEL treats FINISH as terminal, so one NO_FRONTIER
         result ends the mission permanently. That is fatal here: the mission triggers the
         planner the instant the vehicle crosses the arena threshold, when the interior is
         still unmapped, so the first plan reliably finds nothing. These bound how many times
         planning is re-attempted before exploration is accepted as genuinely complete.
         GENERATED from nidar/planner by nidar_config/scripts/apply_mission_config.py. -->
    <param name="fsm/finish_recheck_interval" value="2.0" type="double"/>
    <param name="fsm/finish_recheck_max" value="15" type="int"/>

    <!-- Exploration manager -->

    <param name="exploration/refine_local" value="true" type="bool"/>
    <param name="exploration/refined_num" value="7" type="int"/>
    <param name="exploration/refined_radius" value="5.0" type="double"/>
    <param name="exploration/max_decay" value="0.8" type="double"/>
    <param name="exploration/top_view_num" value="15" type="int"/>
    <param name="exploration/vm" value="$(eval 1.0 * arg('max_vel'))" type="double"/>
    <param name="exploration/am" value="$(eval 1.0 * arg('max_acc'))" type="double"/>
    <param name="exploration/yd" value="$(eval 60 * 3.1415926 / 180.0)" type="double"/>
    <param name="exploration/ydd" value="$(eval 90 * 3.1415926 / 180.0)" type="double"/>
    <param name="exploration/w_dir" value="1.5" type="double"/>
    <param name="exploration/tsp_dir" value="$(find lkh_tsp_solver)/resource" type="string"/>
    <param name="exploration/relax_time" value="1.0" type="double"/>

    <!-- Target hysteresis. Without this the planner re-derives its next viewpoint from
         scratch every replan (~0.2-1.5 s) and takes whatever is cheapest at that instant;
         with several near-tied frontiers the commanded target flipped on 12 of 12
         consecutive 5 s telemetry samples (mean 99 deg of yaw per flip), which is what
         produced the visible ~5 s-period cruise oscillation.
         switch_margin is in SECONDS of ViewNode::computeCost, which is
         max(path_len/max_vel, yaw_diff/yaw_rate); at max_vel=0.6 and yd=60 deg/s the 1.0
         default means a challenger must save >0.6 m of flight or >60 deg of turning before
         the vehicle abandons the target it is already flying to. Set to 0.0 to restore
         upstream stateless behaviour.
         reached_dist releases the hold on arrival; match_dist releases it when no active
         viewpoint remains near the held target (its frontier got cleared).
         See PLANNING_DOCS/fuel_repeat_scan_root_cause_2026-09-04.md Sec 6.3. -->
    <!-- Consecutive "No path to next viewpoint" failures tolerated before the committed
         target is released. 1 (upstream behaviour) let 1141 transient A* misses disarm the
         anti-thrash hold in a single flight, so the vehicle ping-ponged between targets. -->
    <param name="exploration/target_fail_limit" value="5" type="int"/>
    <!-- Retirement guards. A frontier is retired only when A* has failed against it for
         target_fail_limit cycles AND those failures span target_fail_min_seconds of real
         time, and no two retirements may land within frontier/retire_min_interval seconds.
         Replanning runs at tens of hertz, so a cycle count alone is met in milliseconds by a
         vehicle that cannot fly; such a vehicle fails A* to every frontier at once. On
         2026-09-07 that retired 19 frontiers in 0.9 s, emptied the list, and published
         /exploration_completed at 75.7% coverage: a crash reported as a finished mission. -->
    <param name="exploration/target_fail_min_seconds" value="3.0" type="double"/>
    <param name="frontier/retire_min_interval" value="5.0" type="double"/>
    <!-- A watchdog-retired cluster stays dormant this long. Without it the dormant re-check
         resurrects the cluster within a cycle (the vehicle is still beside it, so its cells are
         in the update box and changing) and the planner re-selects the same unreachable cluster
         under a new id. Bounded, so a route that genuinely opens later is not lost forever. -->
    <param name="frontier/retire_cooldown" value="60.0" type="double"/>
    <!-- End exploration yaw trajectories along the flight path instead of facing the
         frontier centroid. Valid ONLY while the sensor is omnidirectional (left/right_angle
         = PI); set false for a limited-FOV sensor, where heading decides what gets mapped. -->
    <param name="exploration/yaw_follows_path" value="true" type="bool"/>;
    <!-- Yaw rate limit for the yaw B-spline. Was never set, so planner_manager defaulted it
         to -1 and generated yaw trajectories with NO rate limit: measured peak 111 deg/s
         against a 60 deg/s airframe limit. -->
    <param name="manager/max_yawdot" value="$(eval 60 * 3.1415926 / 180.0)" type="double"/>;
    <param name="exploration/target_switch_margin" value="3.0" type="double"/>
    <param name="exploration/target_reached_dist" value="0.4" type="double"/>
    <param name="exploration/target_match_dist" value="3.5" type="double"/>

    <!-- Progress watchdog. target_fail_limit above only counts A* failures, so it cannot see a
         target the planner can path to but the vehicle never reaches: the frontier is then
         never observed, never cleared and never retired. Measured 20260907_213348: 861
         successful plans across a 755 s stall that moved coverage 0.1 m2. A genuine traverse
         closes the gap every cycle and resets this timer, so only an unreachable target
         expires it. -->
    <param name="exploration/target_stale_seconds" value="20.0" type="double"/>
    <param name="exploration/target_progress_eps" value="0.15" type="double"/>
    <!-- Ignores target identity: retires whatever target is held when no cluster has been
         covered for this long. Catches the thrashing case the per-target timer misses. -->
    <!-- 25, was 40. This is how long a worthless target can be held before the watchdog
         retires it, and it is the ONLY corrective for a bad pick: the 3.0 s hysteresis margin
         actively defends whatever was chosen. Run 20260909_111512 spent a 94 s stall on it -
         three firings at 40 s each, the first retiring (16.13, 6.28, 1.19). The clock resets
         every time a cluster is covered, and that happened 231 times in 407 s in that run
         (~once per 1.8 s while productive), so 25 s is nowhere near a healthy traverse. -->
    <param name="exploration/global_stale_seconds" value="25.0" type="double"/>

    <!-- Information gain in the ATSP arrival cost. FUEL orders frontiers by travel cost alone
         (ViewNode::computeCost = max(path_len/v_max, yaw_diff/yaw_rate)), so a 17-cell cluster
         and a 1188-cell cluster look identical to the tour. Measured on 20260909_111512 at
         t=220 s: 3184 unknown columns, 1188 in cx 6.5-9.0, 17 beyond cx 15.5 - and the vehicle
         flew to cx 16.0-16.3 and held it for 94 s.

         Arrival cost at cluster k is multiplied by 1/(1 + gain_weight * min(1, cells/ref)):
             17 cells  -> 0.958 (essentially unchanged)
            200+ cells -> 0.667 (33% cheaper)
         so large unknown mass outranks a far-away scrap without small frontiers being
         abandoned - they are deferred, not dropped, so final coverage must not regress.

         ROLLBACK: set gain_weight to 0.0. That returns the cost matrix element for element to
         what it was, and needs no rebuild. -->
    <param name="exploration/gain_weight" value="0.5" type="double"/>
    <param name="exploration/gain_ref_cells" value="200.0" type="double"/>

    <param name="frontier/cluster_min" value="30" type="int"/>
    <param name="frontier/cluster_size_xy" value="2.0" type="double"/>
    <param name="frontier/cluster_size_z" value="10.0" type="double"/>
    <param name="frontier/min_candidate_dist" value="0.5" type="double"/>
    <param name="frontier/min_candidate_clearance" value="0.10" type="double"/>
    <!-- Metres of ESDF clearance a viewpoint must keep BEYOND the 0.40 m inflation band, i.e.
         0.25 here means ~0.65 m from the true wall surface. Applied as a first-pass preference
         only: if a frontier has no viewpoint that clears it, sampleViewpoints re-runs with 0 and
         behaves exactly as before, so no frontier can be lost to this.

         Sized against measured localisation error, not guessed. On the two clean runs the
         rigid-aligned ground-truth residual was median 0.09 m / p90 0.16 m (20260909_040942 and
         20260909_075414); the noisier 20260909_082915 was median 0.44 m / p90 0.84 m over its
         mapping phase. 0.25 covers the clean case with margin and stays well inside the 0.130 m
         of usable margin the inflation band already provides on top of it.

         This is deliberately NOT done by raising obstacles_inflation: inf_step =
         ceil(inflation/resolution) quantises 0.45 to 5 cells = 0.50 m, which severs this arena
         down to 0.8 m2 of free space. The standoff moves viewpoints only; the map is untouched. -->
    <param name="frontier/viewpoint_standoff" value="0.25" type="double"/>
    <param name="frontier/candidate_dphi" value="$(eval 10 * 3.1415926 / 180.0)" type="double"/>
    <param name="frontier/candidate_rnum" value="5" type="int"/>
    <!-- rmin was 0.4. Viewpoints are clamped to z in [1.35,1.45] (below) while frontier cells span
         the map box z in [1.2,1.6], so a cell sits up to 0.25m above/below the viewpoint. A real
         VLP-16 only returns beams within +/-15deg of horizontal, so seeing a 0.25m offset needs a
         horizontal standoff of 0.25/tan(15deg) = 0.93m. Every sample radius below that is
         physically blind to the top and bottom of the slab no matter what the FOV model claims.
         rmin=1.0 keeps all six sampled radii {1.0,1.32,1.64,1.96,2.28,2.6} outside the blind cone.
         See PLANNING_DOCS/fuel_repeat_scan_root_cause_2026-09-04.md Sec 2. -->
    <param name="frontier/candidate_rmin" value="1.0" type="double"/>
    <param name="frontier/candidate_rmax" value="2.6" type="double"/>
    <!-- Viewpoint candidates otherwise inherit their frontier cluster's own mean Z exactly, which
         drags cruise altitude up/down to match wherever a frontier happens to be, producing
         constant oscillation instead of steady cruise flight. Clamp to a band around the 1.5m
         takeoff altitude (camera_init frame; ~1.3-1.8m in world frame) so FUEL still explores in
         3D but doesn't chase every frontier's exact height. -->
    <!-- max kept at 1.6 (world ~1.7m), leaving 0.1m of margin below the guard's 1.8m effective
         ceiling so trajectory overshoot around the clamped viewpoint doesn't trigger rejects. -->
    <param name="frontier/min_candidate_z" value="1.19" type="double"/>
    <param name="frontier/max_candidate_z" value="1.29" type="double"/>
    <param name="frontier/down_sample" value="3" type="int"/>;
    <!-- was 10. min_visib_num is compared against countVisibleCells(), which iterates
         frontier.filtered_cells_ - the cluster AFTER voxel-grid downsampling at
         resolution*down_sample = 0.1*3 = 0.3m (frontier_finder.cpp downsample()). A minimum-size
         cluster (cluster_min=30 raw 0.1m cells) inside the 0.4m-tall map slab collapses to roughly
         5 filtered cells, and a typical wall-following cluster to ~10-20. Requiring visib_num > 10
         was therefore unsatisfiable for small and mid clusters no matter where the viewpoint
         stood, which is a large part of why ~60% of frontiers ended up dormant (measured: dormant
         mean 16.25 vs visitable 10.7). 3 means "see at least 4 of the downsampled cells". -->
    <param name="frontier/min_visib_num" value="3" type="int"/>;
    <param name="frontier/min_view_finish_fraction" value="0.6" type="double"/>;

    <!-- Perception utils (360-degree VLP-16 LiDAR Configuration) -->
    <param name="perception_utils/is_lidar" value="true" type="bool"/>;
    <!-- top_angle was 0.56125 rad (32.2deg), but the VLP-16 actually spawned in Gazebo scans
         vertical min_angle/max_angle = -0.261799..0.261799 rad, i.e. +/-15deg
         (iris_vlp16.sdf, sensor "velodyne-VLP16"). insideFOV() accepted any cell with elevation
         <= top_angle_, so the planner credited viewpoints with seeing cells between 15 and 32deg
         elevation that the sensor can never return. Those cells stayed unknown after the visit,
         the frontier failed min_view_finish_fraction, and FUEL re-targeted the same place - the
         repeated corridor re-scans (measured mean 2.24 visits/cell, worst cell 10). Set to the
         sensor's real half-FOV. -->
    <param name="perception_utils/top_angle" value="0.261799" type="double"/>;
    <param name="perception_utils/left_angle" value="3.14159" type="double"/>;
    <param name="perception_utils/right_angle" value="3.14159" type="double"/>;
    <!-- was 4.5 while sdf_map/max_ray_length integrates to 6.5, so the planner under-credited
         standoff viewpoints and preferred close ones, which are exactly the ones inside the
         vertical blind cone. Raised to 6.0, still under the 6.5m raycast limit so the visibility
         model never claims range the map does not actually integrate. -->
    <param name="perception_utils/max_dist" value="6.0" type="double"/>;
    <param name="perception_utils/vis_dist" value="1.0" type="double"/>;


    <param name="heading_planner/yaw_diff" value="$(eval 30 * 3.1415926 / 180.0)" type="double"/>
    <param name="heading_planner/half_vert_num" value="5" type="int"/>
    <param name="heading_planner/lambda1" value="2.0" type="double"/>
    <param name="heading_planner/lambda2" value="1.0" type="double"/>
    <param name="heading_planner/max_yaw_rate" value="$(eval 10 * 3.1415926 / 180.0)" type="double"/>
    <param name="heading_planner/w" value="20000.0" type="double"/>
    <param name="heading_planner/weight_type" value="1" type="double"/>

  <!-- planner manager -->
    <!-- <param name="manager/max_vel" value="$(arg max_vel)" type="double"/> -->
    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="manager/max_jerk" value="4" type="double"/>
    <param name="manager/dynamic_environment" value="0" type="int"/>
    <param name="manager/local_segment_length" value="6.0" type="double"/>
    <param name="manager/clearance_threshold" value="0.2" type="double"/>
    <param name="manager/control_points_distance" value="0.35" type="double"/>
    <param name="manager/use_geometric_path" value="true" type="bool"/>
    <param name="manager/use_kinodynamic_path" value="true" type="bool"/>
    <param name="manager/use_topo_path" value="true" type="bool"/>
    <param name="manager/use_optimization" value="true" type="bool"/>
    <param name="manager/use_active_perception" value="true" type="bool"/>
    <param name="manager/min_time" value="true" type="bool"/>

  <!-- kinodynamic path searching -->
    <param name="search/max_tau" value="0.8" type="double"/>
    <param name="search/init_max_tau" value="1.0" type="double"/>
    <param name="search/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="search/vel_margin" value="0.25" type="double"/>
    <param name="search/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="search/w_time" value="10.0" type="double"/>
    <param name="search/horizon" value="5.0" type="double"/>
    <param name="search/lambda_heu" value="10.0" type="double"/>
    <param name="search/resolution_astar" value="0.025" type="double"/>
    <param name="search/time_resolution" value="0.8" type="double"/>
    <param name="search/margin" value="0.2" type="double"/>
    <param name="search/allocate_num" value="100000" type="int"/>
    <param name="search/check_num" value="10" type="int"/>
    <param name="search/optimistic" value="false" type="bool"/>

    <param name="astar/lambda_heu" value="10000.0" type="double"/>
    <param name="astar/resolution_astar" value="0.2" type="double"/>
    <param name="astar/allocate_num" value="1000000" type="int"/>
    <param name="astar/max_search_time" value="0.001" type="double"/>

  <!-- trajectory optimization -->
    <param name="optimization/ld_smooth" value="20.0" type="double"/>
    <param name="optimization/ld_dist" value="10.0" type="double"/>
    <param name="optimization/ld_feasi" value="2.0" type="double"/>
    <param name="optimization/ld_start" value="100.0" type="double"/>
    <param name="optimization/ld_end" value="0.5" type="double"/>
    <param name="optimization/ld_guide" value="1.5" type="double"/>
    <param name="optimization/ld_waypt" value="0.3" type="double"/>
    <param name="optimization/ld_view" value="0.0" type="double"/>
    <param name="optimization/ld_time" value="1.0" type="double"/>
    <!-- Fixed-altitude 2D flight: pulls every B-spline control point toward z_cruise, not just
         frontier endpoints. See
         PLANNING_DOCS/fixed_altitude_2d_flight_architecture_2026-09-03.md Sec 5.
         Starting weight, not yet empirically tuned; set to 0.0 to disable without
         reverting the rest of the plan if it destabilizes the optimizer. -->
    <param name="optimization/ld_alt" value="5.0" type="double"/>
    <param name="optimization/z_cruise" value="1.24" type="double"/>
    <!-- was 0.7. This is the soft ESDF repulsion distance: every control point closer than dist0
         to an obstacle is penalised, with weight ld_dist=10.0. The arena's median clearance is
         0.42 m and its widest point is 1.26 m, so at 0.7 essentially EVERY point of EVERY
         trajectory sat inside the penalty band and the distance gradient fought the smoothness
         and endpoint terms continuously instead of only near real hazards: a second, softer
         contributor to the cruise oscillation alongside the target churn fixed above.
         0.5 keeps a genuine repulsion margin beyond the 0.42 hard inflation while being
         achievable in the parts of this arena the vehicle can actually occupy. Paired with the
         obstacles_inflation change above; revert both together if reverting either. -->
    <param name="optimization/dist0" value="0.5" type="double"/>
    <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="optimization/algorithm1" value="15" type="int"/>
