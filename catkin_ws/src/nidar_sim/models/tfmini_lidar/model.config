<?xml version="1.0"?>
<model>
  <name>tfmini_lidar</name>
  <version>1.0</version>
  <sdf version='1.5'>model.sdf</sdf>

  <author>
    <name>NIDAR AirMouse</name>
    <email>singhayush5062@gmail.com</email>
  </author>

  <description>
    Benewake TFmini Plus downward-facing rangefinder (simulated). Publishes to PX4 SITL as MAVLink
    DISTANCE_SENSOR (libgazebo_lidar_plugin.so) and to ROS as sensor_msgs/Range on /tfmini/range
    (libgazebo_ros_range.so). Primary height reference for EKF2 (EKF2_HGT_REF=2). See
    PLANNING_DOCS/fixed_altitude_2d_flight_architecture_2026-09-03.md.
  </description>
</model>
