<?xml version="1.0" ?>
<!--
  Benewake TFmini Plus downward-facing rangefinder (simulated).

  Two plugins deliberately share one ray sensor:
    1. libgazebo_lidar_plugin.so  -> PX4 SITL, as MAVLink DISTANCE_SENSOR over the lockstep link
                                     (gazebo_mavlink_interface.cpp::LidarCallback), which PX4's
                                     SimulatorMavlink.cpp turns into the uORB distance_sensor topic
                                     EKF2 fuses. This is the path EKF2_HGT_REF=2 depends on.
    2. libgazebo_ros_range.so     -> ROS, as sensor_msgs/Range on /tfmini/range, consumed by
                                     FAST-LIO's publish_odometry() Z-pin and by
                                     flight_envelope_guard.py's range-staleness watchdog.

  NAMING IS LOAD-BEARING, on both sides, and they must agree:

    * This model's name sets the Gazebo transport topic. gazebo_lidar_plugin.cpp:108-124 takes the
      sensor's scoped link name ("iris_vlp16::tfmini_lidar::link") and uses the second-to-last
      element, publishing on ~/iris_vlp16/link/tfmini_lidar.
    * The MOUNTING JOINT's name sets what PX4 listens for. gazebo_mavlink_interface.cpp:126-176
      scans model_->GetJoints() for a name matching `.*(lidar|sf10a)(.*)`
      (gazebo_mavlink_interface.h:78), strips the trailing "_joint", and subscribes to
      ~/<model>/link/<that name>. So the joint must be named "tfmini_lidar_joint".

  The nested-model branch of that same function does NOT apply here: it only ever examines
  NestedModels()[0], which for iris_vlp16 is the base "iris" include. The joint path is the one
  that carries this sensor. Rename either side, or drop the "_joint" suffix, and PX4 silently
  receives no DISTANCE_SENSOR at all while ROS /tfmini/range keeps working normally, leaving
  EKF2_HGT_REF=2 with no height source.

  See PLANNING_DOCS/fixed_altitude_2d_flight_architecture_2026-09-03.md Sec 15.
-->
<sdf version="1.5">
  <model name="tfmini_lidar">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!-- ~5g, a real TFmini Plus's rough weight. Explicit on purpose: a link with no
             <inertial> commonly defaults to 1kg, which on a ~1.5kg iris airframe would be a
             silent ~65% mass increase and would visibly degrade flight dynamics. -->
        <mass>0.005</mass>
        <inertia>
          <ixx>1.0e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.0e-7</iyy>
          <iyz>0</iyz>
          <izz>1.0e-7</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <!-- The STL is authored with its origin at a CORNER (measured bbox 0..25, 0..21, 0..35
             raw units), while the collision box below is centred on the link origin. Without
             this offset the drawn body sat half a box-height above its own collision volume,
             which is how the sensor ended up looking buried in the airframe while its collision
             said otherwise. Shift by -half the scaled extent on each axis to centre them. -->
        <!-- MOUNTING ORIENTATION, derived from the mesh itself, not assumed.
             Face survey of tfmini.stl (1636 tris, bbox 25 x 21 x 35 mm, corner origin):
               -X : TWO identical circles, r = 8.4 mm, at (y,z) = (4.8, 7.3) and (4.8, 27.7).
                    Identical size and count = the transmit/receive LENS PAIR. This face is
                    the optical face and MUST point along the beam.
               +X : one r = 12.5 mm plus one r = 4.7 mm, i.e. connector and a fixing hole.
                    This is the back, so it is the face that mates with the airframe plate.
             So the optical axis is the mesh's X, while the ray sensor below points down the
             link's -Z (its own pose carries pitch +90 deg). Left unrotated the drawn body
             therefore faced sideways while the beam went down: the mesh and the measurement
             disagreed by exactly 90 deg.
             Ry(-90 deg) maps mesh -X onto -Z, so the lens pair ends up at the BOTTOM
             (verified: a lens-face point maps to z = 0.0000, the minimum of the rotated
             extent 0.0000 .. 0.0250). The translation re-centres the corner-origin mesh on
             the link after that rotation. -->
        <pose>0.0175 -0.0105 -0.0125 0 -1.5707963 0</pose>
        <geometry>
          <mesh>
            <uri>model://tfmini_lidar/meshes/tfmini.stl</uri>
            <!-- The CAD file is authored in millimetres (measured bounding box 25 x 21 x 35 raw
                 units). Without this scale it would spawn as a 25-metre block. -->
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>

      <!-- Simple primitive rather than the CAD mesh: detailed concave collision meshes are
           expensive and prone to spawn-time interpenetration instability. Sized from the same
           measured bounding box, mm -> m. -->
      <collision name="collision">
        <geometry>
          <box>
            <!-- Rotated dimensions: the visual is turned Ry(-90 deg) so the 25 mm optical
                 axis is now vertical and the 35 mm axis is horizontal. Box follows the mesh,
                 or the two disagree again. -->
            <size>0.035 0.021 0.025</size>
          </box>
        </geometry>
      </collision>

      <sensor name="tfmini_lidar" type="ray">
        <!-- BEAM DIRECTION. This is coupled to the MOUNT pose in the vehicle SDF and must be
             re-solved whenever that changes: the sensor is a child of the link, so rotating the
             link to make the body look right also swings the beam.
             Measured 2026-09-06: the mount was given roll = -1.5369 to turn the lens pair
             groundward, which left the old "pitch 90" beam pointing at
             (+0.006, -0.999, -0.034), i.e. 1.9 deg below horizontal. Parked, it read 5.7955 m
             off a distant wall instead of 0.15 m off the pad. With EKF2_HGT_REF=2 that is the
             only height source, so it would have flown on a sideways altimeter.
             Solved for the mount actually in use:
                 R_sensor . x_hat = R_link^-1 . (0, 0, -1)
             giving pitch 0.033896, yaw 1.575399, verified beam (0, 0, -1.0000), -90.0 deg. -->
        <pose>0 0 0 0 0.033896 1.575399</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.06</min> <!-- do not change: use min_distance (below) for realistic behavior -->
            <max>35</max>   <!-- do not change: use max_distance (below) for realistic behavior -->
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>

        <plugin name="LaserPlugin" filename="libgazebo_lidar_plugin.so">
          <robotNamespace></robotNamespace>
          <min_distance>0.1</min_distance>
          <max_distance>12.0</max_distance>
        </plugin>

        <plugin name="tfmini_ros_range" filename="libgazebo_ros_range.so">
          <robotNamespace></robotNamespace>
          <topicName>/tfmini/range</topicName>
          <frameName>tfmini_link</frameName>
          <fov>0.05</fov>
          <radiation>infrared</radiation>
          <minRange>0.1</minRange>
          <maxRange>12.0</maxRange>
          <gaussianNoise>0.01</gaussianNoise>
          <updateRate>20</updateRate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
