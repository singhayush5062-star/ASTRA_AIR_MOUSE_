<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="nidar_arena">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://nidar_arena/meshes/mapdraw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <!-- mu/mu2 were 100/50, roughly two orders of magnitude above any real material
               (typical concrete-on-rubber is ~0.6-1.0; ODE/SDF's own unset default is 1.0, which
               is what the vehicle's own collision surfaces use). At that friction, any contact
               between the vehicle's collision box and a wall resists tangential sliding almost
               completely instead of letting the vehicle deflect and continue past: motor thrust
               fights the contact instead of the vehicle sliding along the wall, which reads as the
               drone getting physically stuck to the wall on contact. Set to ODE's own default
               (1.0) rather than removing the override, so the value stays visible and intentional
               rather than reverting to "whatever the engine happens to default to". See
               PLANNING_DOCS/guard_state_validation_and_wall_stuck_fix_2026-09-04.md Sec 4. -->
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://nidar_arena/meshes/mapdraw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
