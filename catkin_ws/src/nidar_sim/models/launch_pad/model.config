<?xml version="1.0"?>
<model>
  <name>launch_pad</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>
  <author>
    <name>NIDAR AirMouse</name>
    <email>singhayush5062@gmail.com</email>
  </author>
  <description>
    Launch/landing pad placed outside the arena. Source mesh is in millimetres with Y as its up
    axis; model.sdf rescales it to a 1.5 m square 0.03 m thick and rotates it Z-up. Default
    placement is world (0.00, -9.50), 2.0 m due south of the arena's south door.
  </description>
</model>
