<launch>
  <!-- NIDAR simulation: Gazebo with the competition world, PX4 SITL and MAVROS.

       Thin composition over PX4's own mavros_posix_sitl.launch that pins the world to
       this package's nidar_competition.world. Every argument is passed straight through,
       so `roslaunch nidar_sim nidar_sim.launch <args>` starts exactly the node set that
       `roslaunch px4 mavros_posix_sitl.launch world:=... <args>` does.

       Gazebo resolves model://arina_nidar, launch_pad, tfmini_lidar, ... from this
       package's models/ directory, which scripts/setup_env.sh puts on GAZEBO_MODEL_PATH.
       The world itself is GENERATED by nidar_config/scripts/apply_mission_config.py. -->

  <arg name="vehicle" default="x500_vlp16"/>
  <arg name="world" default="$(find nidar_sim)/worlds/nidar_competition.world"/>
  <arg name="gui" default="true"/>
  <arg name="interactive" default="false"/>
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="0"/>
  <arg name="R" default="0"/>
  <arg name="P" default="0"/>
  <arg name="Y" default="0"/>

  <include file="$(find px4)/launch/mavros_posix_sitl.launch">
    <arg name="vehicle" value="$(arg vehicle)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="interactive" value="$(arg interactive)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="R" value="$(arg R)"/>
    <arg name="P" value="$(arg P)"/>
    <arg name="Y" value="$(arg Y)"/>
  </include>
</launch>
