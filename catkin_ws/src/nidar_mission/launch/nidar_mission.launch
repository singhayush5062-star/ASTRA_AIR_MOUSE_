<launch>
  <!-- NIDAR mission FSM: entry, exploration hand-off, return and landing, plus the
       coverage reporter.

       Loads the central configuration onto the parameter server and starts the mission
       nodes that consume it. This is additive: it does NOT start Gazebo, PX4, FAST-LIO or
       FUEL - scripts/test_takeoff.sh brings those up. Perception (nidar_perception) and the
       2D map (nidar_map2d) are composed alongside this file by
       nidar_bringup/launch/mission_only.launch, which is what test_takeoff.sh runs.

       Everything under /nidar/... comes from one file, so the EDM, the mission manager and
       the survivor detector all read the same numbers. Values that cannot be served from
       the parameter server - FAST-LIO's own YAML, FUEL's roslaunch literals, the Gazebo
       world - are rendered by nidar_config/scripts/apply_mission_config.py instead; run that after
       editing the config. -->

  <arg name="config" default="$(find nidar_config)/config/mission_config.yaml"/>
  <arg name="grid_config" default="$(find nidar_config)/config/arena_grid.yaml"/>
  <arg name="entry_enabled" default="true"/>
  <arg name="coverage_report_enabled" default="true"/>

  <rosparam command="load" file="$(arg config)"/>
  <rosparam command="load" file="$(arg grid_config)"/>

  <!-- Autonomous arena entry. Drives /planning/pos_cmd (validated by
       flight_envelope_guard.py) from the launch pad, through the arena opening, and hands
       over to FUEL once inside. -->
  <node if="$(arg entry_enabled)"
        pkg="nidar_mission" type="mission_manager.py" name="entry_detection_module"
        output="screen"/>

  <!-- Phase 4 coverage reporter. One terminal line per 20% coverage growth,
       carrying both percentage and m^2 breakdown. Exactly what the operator
       needs while the GCS is not yet wired up. -->
  <node if="$(arg coverage_report_enabled)"
        pkg="nidar_mission" type="coverage_reporter.py" name="coverage_reporter"
        output="screen"/>

</launch>
