<launch>
    <!-- Launch file for FAST-LIO customized for NIDAR simulation -->
    
    <arg name="rviz" default="true" />
    <!-- The real drone: config:=$(find nidar_slam)/config/fast_lio/nidar_hw.yaml use_urdf:=false
         (generated by nidar_config/scripts/apply_hardware_config.py; its static TF, including
         body -> base_link, comes from nidar_hardware/scripts/hw_static_tf.py). -->
    <arg name="config" default="$(find nidar_slam)/config/fast_lio/nidar_sim.yaml" />
    <arg name="use_urdf" default="true" />
    <!-- CPU load. The real drone passes hardware.yaml lidar.fastlio (hw_bringup.sh); the
         simulation keeps these defaults. -->
    <arg name="point_filter_num" default="4" />
    <arg name="filter_size" default="0.5" />

    <rosparam command="load" file="$(arg config)" />

    <!-- FAST-LIO Global parameters -->
    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="$(arg point_filter_num)"/>
    <param name="max_iteration" type="int" value="3" />
    <param name="filter_size_surf" type="double" value="$(arg filter_size)" />
    <param name="filter_size_map" type="double" value="$(arg filter_size)" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="0" />

    <!-- Load URDF (simulation airframe) -->
    <group if="$(arg use_urdf)">
        <param name="robot_description" textfile="$(find nidar_slam)/config/iris_vlp16.urdf" />
        <node pkg="robot_state_publisher" type="robot_state_publisher" name="nidar_robot_state_publisher" output="screen" />
    </group>

    <!-- FAST-LIO node -->
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen">
        <remap from="/Odometry" to="/Fast_LIO/odometry" />
    </node>

    <!-- Publish actual drone trajectory path from FAST-LIO odometry -->
    <node pkg="fast_lio" type="flight_path_publisher.py" name="flight_path_publisher" output="screen">
        <param name="odom_topic" value="/Fast_LIO/odometry" />
        <param name="path_topic" value="/flight_path" />
        <param name="frame_id" value="camera_init" />
        <param name="max_points" value="15000" />
        <param name="min_translation" value="0.02" />
        <param name="min_yaw" value="0.01" />
    </node>

    <!-- RViz -->
    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find nidar_slam)/rviz/nidar_lidar.rviz" />
    </group>

</launch>
