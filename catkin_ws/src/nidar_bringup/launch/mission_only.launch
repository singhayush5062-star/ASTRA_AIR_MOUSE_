<launch>
  <!-- NIDAR mission layer, composed: everything that runs on top of an already-flying
       stack (PX4 + MAVROS, FAST-LIO, FUEL, flight envelope guard).

       This is what scripts/test_takeoff.sh starts as "the mission layer". It brings up,
       in one roslaunch process:
         nidar_mission     mission FSM (entry, exploration hand-off, return, land),
                           coverage reporter
         nidar_perception  camera TF chain + survivor detector
         nidar_map2d       live 2D map, grid overlay, survivor tags

       Every argument the pre-split nidar_mission.launch accepted is accepted here with the
       same name and default, and forwarded to the package that now owns it. -->

  <arg name="config" default="$(find nidar_config)/config/mission_config.yaml"/>
  <arg name="grid_config" default="$(find nidar_config)/config/arena_grid.yaml"/>
  <arg name="entry_enabled" default="true"/>
  <arg name="detection_enabled" default="true"/>
  <arg name="coverage_report_enabled" default="true"/>
  <arg name="map_2d_enabled" default="true"/>
  <arg name="grid_visualizer_enabled" default="true"/>
  <!-- Perception overrides for the real drone (defaults: the simulation, see detector.launch). -->
  <arg name="camera_tf" default="true"/>
  <arg name="model_path" default="$(find nidar_perception)/models/detection/YOLO26S_DRONE_PERSON_V1/best.pt"/>
  <arg name="rotate_180" default="true"/>
  <arg name="device" default="auto"/>
  <arg name="detect_hz" default="5.0"/>
  <arg name="confidence_threshold" default="0.55"/>
  <arg name="target_height_m" default="0.35"/>
  <arg name="ground_truth_check" default="true"/>

  <include file="$(find nidar_mission)/launch/nidar_mission.launch">
    <arg name="config" value="$(arg config)"/>
    <arg name="grid_config" value="$(arg grid_config)"/>
    <arg name="entry_enabled" value="$(arg entry_enabled)"/>
    <arg name="coverage_report_enabled" value="$(arg coverage_report_enabled)"/>
  </include>

  <include file="$(find nidar_perception)/launch/detector.launch">
    <arg name="config" value="$(arg config)"/>
    <arg name="grid_config" value="$(arg grid_config)"/>
    <arg name="detection_enabled" value="$(arg detection_enabled)"/>
    <arg name="camera_tf" value="$(arg camera_tf)"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="rotate_180" value="$(arg rotate_180)"/>
    <arg name="device" value="$(arg device)"/>
    <arg name="detect_hz" value="$(arg detect_hz)"/>
    <arg name="confidence_threshold" value="$(arg confidence_threshold)"/>
    <arg name="target_height_m" value="$(arg target_height_m)"/>
    <arg name="ground_truth_check" value="$(arg ground_truth_check)"/>
  </include>

  <include file="$(find nidar_map2d)/launch/map2d.launch">
    <arg name="config" value="$(arg config)"/>
    <arg name="grid_config" value="$(arg grid_config)"/>
    <arg name="map_2d_enabled" value="$(arg map_2d_enabled)"/>
    <arg name="grid_visualizer_enabled" value="$(arg grid_visualizer_enabled)"/>
  </include>
</launch>
