# NIDAR AirMouse GCS — Backend Configuration
# ============================================

# Backend Host & Port
HOST=0.0.0.0
PORT=8000
RELOAD=True
LOG_LEVEL=info

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# FC / JETSON CAMERA NETWORK STREAM CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Set this to the IP address of your Flight Controller / Jetson
FC_HOST=192.168.1.100

# Stream port on FC / Jetson (e.g., 8554 for RTSP, 8080 for HTTP MJPEG, 5600 for UDP)
FC_CAMERA_PORT=8554

# Complete stream URL from FC / Jetson
# Examples:
#   RTSP:         rtsp://192.168.1.100:8554/live
#   HTTP/MJPEG:   http://192.168.1.100:8080/stream
#   UDP:          udp://192.168.1.100:5600
FC_CAMERA_URL=rtsp://192.168.1.100:8554/live

# Protocol type: rtsp | http | udp | tcp
FC_CAMERA_TYPE=rtsp

# Reconnect interval in seconds when FC camera is disconnected
FC_RECONNECT_INTERVAL=3.0
