# NIDAR AirMouse GCS — Backend Configuration
# ============================================

# Backend Host & Port
HOST=0.0.0.0
PORT=8000
RELOAD=False
LOG_LEVEL=info

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# FC / JETSON CAMERA NETWORK STREAM CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Set this to the IP address of your Flight Controller / Jetson
FC_HOST=192.168.1.100

# Stream port on FC / Jetson (e.g., 8554 for RTSP, 8080 for HTTP MJPEG, 5600 for UDP)
FC_CAMERA_PORT=8554

# Complete stream URL from FC / Jetson
# Examples:
#   RTSP:         rtsp://192.168.1.100:8554/live
#   HTTP/MJPEG:   http://192.168.1.100:8080/stream
#   UDP:          udp://192.168.1.100:5600
FC_CAMERA_URL=rtsp://192.168.1.100:8554/live

# Protocol type: rtsp | http | udp | tcp
FC_CAMERA_TYPE=rtsp

# Reconnect interval in seconds when FC camera is disconnected
FC_RECONNECT_INTERVAL=3.0

# ─────────────────────────────────────────────────────────────
# NIDAR SIMULATION (Simulation dashboard)
# ─────────────────────────────────────────────────────────────
# Also open the Gazebo window when START is pressed (the web UI is the operator display).
SIM_GAZEBO_GUI=False
# Serve the old synthetic data instead of the real simulation (UI work without ROS).
GCS_MOCK=False

# ─────────────────────────────────────────────────────────────
# REAL DRONE (Hardware dashboard)  — see hardware/DEPLOYMENT.md §8
# ─────────────────────────────────────────────────────────────
# Seconds CONNECT waits for the flight controller heartbeat (radio links need a few).
MAVLINK_CONNECT_TIMEOUT_S=6.0
# The Jetson's ROS master (live map, survivors, mission state, onboard camera, TAKEOFF/RTL):
#   auto  = the IP the MAVLink UDP packets come from (Wi-Fi via MAVROS gcs_url)
#   empty = MAVLink only (T12 / SiK radio without Wi-Fi)
#   http://<jetson-ip>:11311 = explicit (needed with a serial link + Wi-Fi at the same time)
DRONE_ROS_MASTER_URI=auto
# This laptop's IP as the Jetson reaches it. Empty = detected from the route to the Jetson.
DRONE_ROS_IP=
# MAVROS component id on the Jetson; TAKEOFF/RTL over a radio link are addressed to it.
COMPANION_COMPID=240
